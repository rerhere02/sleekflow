# Target environment: stg | prod
ENV=stg

# Primary test account credentials
TEST_EMAIL=sftestq+owner@gmail.com
TEST_PASSWORD=

# Browser mode: true (headless) | false (headed)
HEADLESS=true

# Gmail IMAP — required for email verification tests (@creates-account)
GMAIL_APP_PASSWORD=

# Auth0 Management API — optional, enables auto-cleanup of test accounts
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
